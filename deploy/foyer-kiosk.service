# Takes tty1 from the Ubuntu Server console so sway paints over the login TTY.
# HDMI/DP must be connected before this unit starts (Wyse 5070 dual DP typical).
# Setup writes data/foyer-kiosk.env (Welcome + Room panel outputs + Relay URL) then restarts this unit.
# F3/F4: one sway seat; Welcome and/or Room-panel Chromium per Setup picks.
# Clearing or changing either role in Setup restarts this unit (same-output reject does not).
[Unit]
Description=Foyer local-video kiosk (sway dual Chromium)
After=foyer.service systemd-user-sessions.service plymouth-quit-wait.service
Requires=foyer.service
Conflicts=getty@tty1.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=USER
SupplementaryGroups=video render input tty
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UnsetEnvironment=TERM
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=WLR_LIBINPUT_NO_DEVICES=1
EnvironmentFile=-/home/USER/Foyer-Room-Signage/data/foyer-kiosk.env
ExecStartPre=+/bin/chvt 1
ExecStart=/home/USER/Foyer-Room-Signage/scripts/foyer-kiosk-sway.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
